# ==========================================
# cPanel Apache / LiteSpeed Configuration
# ==========================================

# Enable Passenger
PassengerAppRoot "/home/username/public_html"
PassengerPython "/home/username/virtualenv/public_html/3.11/bin/python"
PassengerAppType wsgi
PassengerStartupFile passenger_wsgi.py

# Prevent directory listings
Options -Indexes

# Static and Media routing handled by Apache directly
RewriteEngine On
RewriteCond %{REQUEST_URI} ^/static/ [NC,OR]
RewriteCond %{REQUEST_URI} ^/media/ [NC]
RewriteRule ^ - [L]

# Redirect HTTP to HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
