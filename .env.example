# ==========================================
# Market Intelligence Platform Configuration
# ==========================================

# Core Django Settings
DEBUG=True
SECRET_KEY=generate-a-secure-random-secret-key-at-least-50-characters
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# Database Selection: sqlite, mysql, or postgresql
DB_ENGINE=sqlite
DB_NAME=market_intel.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# Security & Symmetric Token Encryption (Fernet Key)
# Generate one using: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# Execution Mode: cpanel_cron (Mode A) or celery_worker (Mode B)
EXECUTION_MODE=cpanel_cron
BATCH_COLLECTION_LIMIT=30
CRON_LOCK_TIMEOUT_SECONDS=300

# Google Gemini API — supports multiple keys (comma-separated for circular rotation)
# When one key hits its quota, the system auto-rotates to the next key, cycling back to key 1
# Example with 3 keys: GEMINI_API_KEY=AIzaSyKEY1,AIzaSyKEY2,AIzaSyKEY3
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
# Transcription / Translation Model (e.g. gemini-3.5-transcribe or gemini-2.0-flash / gemini-1.5-flash)
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe

# Telegram Credentials (Official MTProto, Bot API & Alerts)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_BOT_TOKEN=8949334893:AAExxMWjZME_XRgGgrZnD9t9rQNgoivH6EE
TELEGRAM_PHONE_NUMBER=
TELEGRAM_STRING_SESSION=
TELEGRAM_ALERT_CHAT_ID=-1002973190536
TELEGRAM_ALERT_MIN_SCORE=75

# Meta / Facebook Graph API Credentials & Publishing
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=

# LinkedIn REST API Credentials & Publishing
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORG_URN=

# Outgoing Webhooks & API Security
API_DEFAULT_RATE_LIMIT=120/min
WEBHOOK_TIMEOUT_SECONDS=10
