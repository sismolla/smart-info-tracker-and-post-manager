# Django Settings
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
# Options: sqlite, mysql, postgresql
DB_ENGINE=sqlite
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=

# Telegram Alert Bot
TELEGRAM_ALERT_CHAT_ID=
TELEGRAM_ALERT_MIN_SCORE=75

# AI Configuration
GEMINI_API_KEY=
# Multiple keys for rotation (optional)
GEMINI_API_KEYS=key1,key2,key3
AI_DAILY_SPEND_LIMIT_USD=2.00
AI_DAILY_MAX_CALLS=500

# Execution Mode
# Options: cpanel_cron, celery_worker
EXECUTION_MODE=cpanel_cron
BATCH_COLLECTION_LIMIT=30
CRON_LOCK_TIMEOUT_SECONDS=300

# Social Media Credentials (will be encrypted at rest)
# Configure via dashboard UI instead of .env for security
