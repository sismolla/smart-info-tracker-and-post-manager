# ==========================================
# Market Intelligence Platform Configuration
# ==========================================

# Core Django Settings
DEBUG=True
SECRET_KEY=generate-a-secure-random-secret-key-at-least-50-characters
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# Database Selection: sqlite, mysql, or postgresql
DB_ENGINE=sqlite
DB_NAME=market_intel.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# Security & Symmetric Token Encryption (Fernet Key)
# Generate one using: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# Execution Mode: cpanel_cron (Mode A) or celery_worker (Mode B)
EXECUTION_MODE=cpanel_cron
BATCH_COLLECTION_LIMIT=30
CRON_LOCK_TIMEOUT_SECONDS=300

# Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Telegram Credentials (Official MTProto & Bot API)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_BOT_TOKEN=
TELEGRAM_PHONE_NUMBER=

# Meta / Facebook Graph API Credentials
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_PAGE_ACCESS_TOKEN=

# LinkedIn REST API Credentials
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=

# Outgoing Webhooks & API Security
API_DEFAULT_RATE_LIMIT=120/min
WEBHOOK_TIMEOUT_SECONDS=10
